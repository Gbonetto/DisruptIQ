# Application
APP_NAME=DisruptIQ
APP_VERSION=1.0.0
DEBUG=False

# Database
DATABASE_URL=postgresql+asyncpg://disruptiq:disruptiq_password@postgres:5432/disruptiq

# Redis
REDIS_URL=redis://redis:6379/0

# Qdrant Vector Database
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=disruptiq_documents

# ============================================
# Mistral AI (PRIMARY - European, GDPR-compliant, French-optimized)
# ============================================
# Get your API key at: https://console.mistral.ai/
MISTRAL_API_KEY=your-mistral-api-key-here
MISTRAL_MODEL=mistral-large-latest              # Best for complex reasoning
MISTRAL_EMBEDDING_MODEL=mistral-embed            # 1024 dimensions
MISTRAL_VISION_MODEL=pixtral-12b-2409           # For OCR and image analysis

# ============================================
# OpenAI (Fallback - Optional)
# ============================================
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# ============================================
# Anthropic (Deprecated)
# ============================================
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_MODEL=claude-3-opus-20240229

# Gmail API (Optional - for email processing)
GMAIL_CREDENTIALS_PATH=./credentials/gmail_credentials.json
GMAIL_TOKEN_PATH=./credentials/gmail_token.json

# N8N Webhooks
N8N_WEBHOOK_BASE_URL=https://your-n8n-instance.com
N8N_WEBHOOK_AUTH_TOKEN=your-secret-webhook-token
N8N_TIMEOUT=30
N8N_MAX_RETRIES=3

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Document Processing
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes

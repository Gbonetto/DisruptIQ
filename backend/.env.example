# ========================================
# OPENAI
# ========================================
# Get your API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_MODEL=gpt-4
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# ========================================
# DATABASE
# ========================================
# For local development (without Docker)
# DATABASE_URL=postgresql+asyncpg://disruptiq:password@localhost:5432/disruptiq

# For Docker Compose
DATABASE_URL=postgresql+asyncpg://disruptiq:disruptiq@postgres:5432/disruptiq

# ========================================
# QDRANT VECTOR DATABASE
# ========================================
# For local development (without Docker)
# QDRANT_URL=http://localhost:6333

# For Docker Compose
QDRANT_URL=http://qdrant:6333

# Qdrant API Key (only if using Qdrant Cloud)
QDRANT_API_KEY=

# Qdrant Collection Name
QDRANT_COLLECTION_NAME=disruptiq_documents

# ========================================
# REDIS (Optional)
# ========================================
# For Docker Compose
REDIS_URL=redis://redis:6379/0

# For local development
# REDIS_URL=redis://localhost:6379/0

# ========================================
# SECURITY & JWT
# ========================================
# Generate a secure random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-to-a-secure-random-string-in-production

# JWT Algorithm
ALGORITHM=HS256

# Token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ========================================
# GMAIL API (For Email Digest)
# ========================================
# Path to Gmail credentials.json file
GMAIL_CREDENTIALS_PATH=credentials/credentials.json

# Path to Gmail token.json file (generated after authentication)
GMAIL_TOKEN_PATH=credentials/token.json

# Gmail API Scopes (do not change unless you know what you're doing)
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly

# ========================================
# CORS
# ========================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# In production, use your actual domain:
# CORS_ORIGINS=https://app.disruptiq.com

# ========================================
# LOGGING
# ========================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: json or text
LOG_FORMAT=json

# ========================================
# N8N WEBHOOKS (Optional)
# ========================================
# Base URL for N8N instance
N8N_BASE_URL=http://n8n:5678

# Webhook endpoints
N8N_NOTIFY_NEIGHBORS_WEBHOOK=/webhook/notify-neighbors
N8N_SEND_VENDOR_EMAILS_WEBHOOK=/webhook/send-vendor-emails
N8N_ARCHIVE_DOCUMENT_WEBHOOK=/webhook/archive-document

# ========================================
# DEVELOPMENT
# ========================================
# Set to "development" or "production"
ENVIRONMENT=development

# Enable debug mode (only for development)
DEBUG=True

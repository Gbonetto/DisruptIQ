# ========================================
# DISRUPTIQ PRODUCTION CONFIGURATION EXAMPLE
# ========================================
# Copy this file to .env.production and fill in the values
# Command: cp .env.production.example .env.production
# ========================================

# ========================================
# APPLICATION SETTINGS
# ========================================
ENVIRONMENT=production
DEBUG=False
APP_NAME=DisruptIQ
APP_VERSION=1.0.0

# ========================================
# SECURITY & JWT
# ========================================
# Generate a secure random key using:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# JWT Algorithm
ALGORITHM=HS256

# Token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ========================================
# MISTRAL AI (Primary LLM)
# ========================================
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_EMBEDDING_MODEL=mistral-embed
MISTRAL_VISION_MODEL=pixtral-12b-2409

# ========================================
# WEB SEARCH APIs (Optional)
# ========================================
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=

# ========================================
# OPENAI (Fallback - Optional)
# ========================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# ========================================
# ANTHROPIC (Deprecated - Optional)
# ========================================
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-opus-20240229

# ========================================
# DATABASE (PostgreSQL)
# ========================================
DATABASE_URL=postgresql+asyncpg://disruptiq:CHANGE_PASSWORD@postgres:5432/disruptiq

# ========================================
# QDRANT VECTOR DATABASE
# ========================================
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=disruptiq_documents

# ========================================
# REDIS
# ========================================
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=True

# ========================================
# CORS (Security)
# ========================================
# Whitelist ONLY your production domains (comma-separated, no spaces)
CORS_ORIGINS=https://your-domain.com

# ========================================
# GMAIL API
# ========================================
GMAIL_CREDENTIALS_PATH=credentials/credentials.json
GMAIL_TOKEN_PATH=credentials/token.json
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/gmail.modify
GMAIL_TIMEOUT=30

# ========================================
# N8N WEBHOOKS
# ========================================
N8N_WEBHOOK_BASE_URL=
N8N_WEBHOOK_AUTH_TOKEN=
N8N_TIMEOUT=30
N8N_MAX_RETRIES=3

# ========================================
# DOCUMENT PROCESSING
# ========================================
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=.pdf,.docx,.doc,.txt,.png,.jpg,.jpeg

# ========================================
# LOGGING
# ========================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ========================================
# RATE LIMITING
# ========================================
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000
UPLOAD_RATE_LIMIT=10

# ========================================
# MONITORING (Optional)
# ========================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ========================================
# BACKUP
# ========================================
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *
